---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;

// Rythme répété : une photo large, puis deux demi-largeurs.
// Les photos en paysage vont de préférence dans les cases larges, les portraits dans les demi-cases.
const paysages = images.filter((image) => image.src.width >= image.src.height);
const portraits = images.filter((image) => image.src.width < image.src.height);
const mosaique = images.map((_, i) => {
	const seuleSurSaLigne = i === images.length - 1 && i % 3 === 1;
	const large = i % 3 === 0 || seuleSurSaLigne;
	const pile = large ? (paysages.length ? paysages : portraits) : portraits.length ? portraits : paysages;
	return { ...pile.shift()!, large };
});
---

<div class="galerie">
	{
		mosaique.map((image) => (
			<Image
				src={image.src}
				alt={image.alt}
				class:list={['galerie__photo', { 'galerie__photo--large': image.large }]}
				width={image.large ? 1600 : 900}
				sizes={image.large ? '(min-width: 80rem) 80rem, 100vw' : '(min-width: 48rem) 40rem, 100vw'}
			/>
		))
	}
</div>

<style>
	.galerie {
		display: grid;
		gap: var(--e-5);
	}

	.galerie__photo {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	@media (min-width: 48rem) {
		.galerie {
			grid-template-columns: 1fr 1fr;
		}

		.galerie__photo {
			aspect-ratio: 4 / 5;
		}

		.galerie__photo--large {
			grid-column: 1 / -1;
			aspect-ratio: 16 / 9;
		}
	}
</style>
