---
interface Props {
	questions: { question: string; reponse: string }[];
}

const { questions } = Astro.props;
---

<section class="section">
	<div class="conteneur faq">
		<div>
			<p class="surtitre">Questions fréquentes</p>
			<h2 class="faq__titre">Vos questions</h2>
		</div>
		<div class="faq__liste">
			{
				questions.map(({ question, reponse }) => (
					<details>
						<summary>{question}</summary>
						<p>{reponse}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		display: grid;
		gap: var(--e-7);
	}

	.faq__titre {
		margin-top: var(--e-4);
	}

	details {
		border-top: 1px solid var(--c-trait);
	}

	details:last-child {
		border-bottom: 1px solid var(--c-trait);
	}

	summary {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--e-5);
		padding-block: var(--e-5);
		font-family: var(--f-titre);
		font-size: var(--t-1);
		line-height: 1.3;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '+';
		flex-shrink: 0;
		font-family: var(--f-texte);
		font-weight: 300;
		transition: transform var(--transition);
	}

	details[open] summary::after {
		transform: rotate(45deg);
	}

	details p {
		max-width: var(--l-texte);
		padding-bottom: var(--e-5);
		color: var(--c-encre-douce);
	}

	@media (min-width: 64rem) {
		.faq {
			grid-template-columns: 1fr 2fr;
			column-gap: var(--e-8);
		}
	}
</style>
