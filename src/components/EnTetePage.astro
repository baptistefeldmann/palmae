---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	surtitre: string;
	/** Peut contenir du HTML simple (`<em>`) */
	titre: string;
	chapeau?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const { surtitre, titre, chapeau, image, imageAlt = '' } = Astro.props;
---

<header class="entete-page">
	<div class="conteneur entete-page__texte">
		<p class="surtitre">{surtitre}</p>
		<h1 set:html={titre} />
		{chapeau && <p class="chapeau">{chapeau}</p>}
	</div>
	{
		image && (
			<div class="conteneur">
				<Image
					src={image}
					alt={imageAlt}
					class="entete-page__image"
					width={1600}
					sizes="(min-width: 80rem) 80rem, 100vw"
					priority
				/>
			</div>
		)
	}
</header>

<style>
	.entete-page {
		padding-top: var(--e-8);
	}

	.entete-page__texte {
		display: grid;
		gap: var(--e-5);
	}

	.entete-page h1 {
		max-width: 16ch;
	}

	.entete-page .chapeau {
		max-width: 36rem;
	}

	.entete-page__image {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		margin-top: var(--e-7);
		object-fit: cover;
	}

	@media (min-width: 48rem) {
		.entete-page__image {
			aspect-ratio: 21 / 9;
		}
	}

	@media (min-width: 64rem) {
		.entete-page__texte {
			grid-template-columns: 1.3fr 1fr;
			align-items: end;
			column-gap: var(--e-8);
		}

		.entete-page .surtitre {
			grid-column: 1 / -1;
		}
	}
</style>
