---
import { Image } from 'astro:assets';
import marque from '../assets/logo/palmae-marque.png';
import { navigation, site } from '../config/site';
import { afficherProjets } from '../lib/projets';
import { base, lien } from '../lib/liens';

const entrees = (await afficherProjets()) ? navigation : navigation.filter((entree) => !entree.siProjets);

// Chemin de la page sans le préfixe de déploiement, pour le comparer aux liens de navigation
const chemin = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const estActif = (href: string) => chemin === href || chemin.startsWith(`${href}/`);
const { telephone } = site.contact;
---

<header class="entete">
	<div class="conteneur entete__barre">
		<a href={lien('/')} class="entete__logo">
			<Image src={marque} alt={`${site.nom}, accueil`} width={132} layout="fixed" priority />
		</a>

		<nav class="entete__nav" aria-label="Navigation principale">
			<ul>
				{
					entrees.map((entree) => (
						<li>
							<a href={lien(entree.href)} aria-current={estActif(entree.href) ? 'page' : undefined}>
								{entree.libelle}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="entete__actions">
			<a class="entete__icone entete__appel" href={`tel:${telephone.lien}`}>
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path
						d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
					></path>
				</svg>
				<span class="visuellement-cache">Appeler le {telephone.affichage}</span>
			</a>
			<a class="bouton entete__devis" href={lien('/devis')}>Demander un devis</a>
			<button class="entete__icone entete__burger" type="button" popovertarget="menu-mobile">
				<span class="entete__burger-traits" aria-hidden="true"></span>
				<span class="visuellement-cache">Menu</span>
			</button>
		</div>
	</div>

	<div id="menu-mobile" class="menu-mobile" popover>
		<div class="conteneur menu-mobile__contenu">
			<div class="menu-mobile__haut">
				<a href={lien('/')} class="entete__logo">
					<Image src={marque} alt={`${site.nom}, accueil`} width={132} layout="fixed" />
				</a>
				<button
					class="entete__icone menu-mobile__fermer"
					type="button"
					popovertarget="menu-mobile"
					popovertargetaction="hide"
				>
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
						<path d="M5 5l14 14M19 5L5 19"></path>
					</svg>
					<span class="visuellement-cache">Fermer le menu</span>
				</button>
			</div>

			<nav aria-label="Menu">
				<ul class="menu-mobile__liens">
					{
						entrees.map((entree) => (
							<li>
								<a href={lien(entree.href)} aria-current={estActif(entree.href) ? 'page' : undefined}>
									{entree.libelle}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="menu-mobile__bas">
				<a class="bouton" href={lien('/devis')}>Demander un devis</a>
				<a class="bouton bouton--contour" href={`tel:${telephone.lien}`}>{telephone.affichage}</a>
				<p class="surtitre">{site.zone}</p>
			</div>
		</div>
	</div>
</header>

<style>
	.entete {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--c-fond) 94%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--c-trait);
	}

	.entete__barre {
		display: flex;
		align-items: center;
		gap: var(--e-6);
		height: var(--hauteur-entete);
	}

	.entete__logo {
		flex-shrink: 0;
	}

	/* ---------- Navigation bureau ---------- */

	.entete__nav {
		display: none;
		margin-inline-start: auto;
	}

	.entete__nav ul {
		display: flex;
		gap: var(--e-6);
		padding: 0;
		list-style: none;
	}

	.entete__nav a {
		position: relative;
		padding-block: var(--e-2);
		font-size: var(--t--1);
		font-weight: 400;
		letter-spacing: 0.14em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.entete__nav a::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition);
	}

	.entete__nav a:hover::after,
	.entete__nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	/* ---------- Actions ---------- */

	.entete__actions {
		display: flex;
		align-items: center;
		gap: var(--e-3);
		margin-inline-start: auto;
	}

	.entete__icone {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--c-encre);
		cursor: pointer;
	}

	.entete__icone svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.entete__devis {
		display: none;
		min-height: 2.75rem;
		padding-inline: 1.25rem;
	}

	.entete__burger-traits,
	.entete__burger-traits::before {
		display: block;
		width: 1.625rem;
		height: 1px;
		background: currentColor;
	}

	.entete__burger-traits {
		position: relative;
		transform: translateY(-4px);
	}

	.entete__burger-traits::before {
		content: '';
		position: absolute;
		top: 8px;
	}

	@media (min-width: 40rem) {
		.entete__devis {
			display: inline-flex;
		}
	}

	@media (min-width: 70rem) {
		.entete__nav {
			display: block;
		}

		.entete__actions {
			margin-inline-start: 0;
		}

		.entete__appel,
		.entete__burger {
			display: none;
		}
	}

	/* ---------- Menu mobile (popover natif : Échap et fermeture gérés par le navigateur) ---------- */

	.menu-mobile {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		overflow-y: auto;
		background: var(--c-fond);
		color: var(--c-encre);
		opacity: 0;
		transition:
			opacity 250ms ease,
			display 250ms allow-discrete,
			overlay 250ms allow-discrete;
	}

	.menu-mobile:popover-open {
		opacity: 1;
	}

	@starting-style {
		.menu-mobile:popover-open {
			opacity: 0;
		}
	}

	:global(body:has(.menu-mobile:popover-open)) {
		overflow: hidden;
	}

	.menu-mobile__contenu {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		padding-bottom: var(--e-7);
	}

	.menu-mobile__haut {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--hauteur-entete);
		margin-bottom: var(--e-7);
	}

	.menu-mobile__liens {
		display: grid;
		gap: var(--e-4);
		padding: 0;
		list-style: none;
	}

	.menu-mobile__liens a {
		font-family: var(--f-titre);
		font-size: var(--t-4);
		line-height: 1.15;
		text-decoration: none;
	}

	.menu-mobile__liens a[aria-current='page'] {
		font-style: italic;
	}

	.menu-mobile__bas {
		display: grid;
		gap: var(--e-3);
		margin-top: auto;
		padding-top: var(--e-8);
	}

	.menu-mobile__bas .surtitre {
		margin-top: var(--e-3);
		color: var(--c-encre-douce);
		text-align: center;
	}

	@media (min-width: 70rem) {
		.menu-mobile {
			display: none;
		}
	}
</style>
