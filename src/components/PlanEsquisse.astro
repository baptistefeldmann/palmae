---
/**
 * Exemple d'esquisse dessinée : plan masse fictif du jardin Tamarin, au Tampon.
 * Les formes organiques sont générées ici ; les filtres SVG donnent le trait « à main levée »
 * et l'effet d'aquarelle. Échelle du dessin : 26 unités = 1 m.
 */
type Pt = [number, number];
const f = (n: number) => n.toFixed(1);

/** Courbe fermée lisse passant par les points (Catmull-Rom convertie en Bézier) */
function formeFermee(points: Pt[]): string {
	const n = points.length;
	let d = `M${points[0][0]},${points[0][1]}`;
	for (let i = 0; i < n; i++) {
		const [p0, p1, p2, p3] = [points[(i - 1 + n) % n], points[i], points[(i + 1) % n], points[(i + 2) % n]];
		d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${p2[0]},${p2[1]}`;
	}
	return `${d}Z`;
}

/** Courbe ouverte lisse passant par les points */
function courbe(points: Pt[]): string {
	const pts = [points[0], ...points, points[points.length - 1]];
	let d = `M${points[0][0]},${points[0][1]}`;
	for (let i = 1; i < pts.length - 2; i++) {
		const [p0, p1, p2, p3] = [pts[i - 1], pts[i], pts[i + 1], pts[i + 2]];
		d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${p2[0]},${p2[1]}`;
	}
	return d;
}

/** Houppier festonné : cercle irrégulier fait de petits arcs */
function houppier(cx: number, cy: number, r: number, bosses = 11, graine = 0): string {
	const corde = 2 * r * Math.sin(Math.PI / bosses);
	const rayonArc = f(corde * 0.62);
	let d = '';
	for (let i = 0; i <= bosses; i++) {
		const k = i % bosses;
		const a = (k / bosses) * Math.PI * 2 + graine;
		const rr = r * (0.92 + 0.08 * Math.sin(k * 2.3 + graine * 5));
		const point = `${f(cx + rr * Math.cos(a))},${f(cy + rr * Math.sin(a))}`;
		d += i === 0 ? `M${point}` : ` A${rayonArc},${rayonArc} 0 0 1 ${point}`;
	}
	return `${d}Z`;
}

/** Symbole de palmier ou de fougère arborescente : palmes courbes rayonnant du stipe */
function palmes(cx: number, cy: number, r: number, nombre = 8, graine = 0): string {
	let d = '';
	for (let i = 0; i < nombre; i++) {
		const a = (i / nombre) * Math.PI * 2 + graine;
		const c = a + 0.4;
		d += `M${cx},${cy} Q${f(cx + r * 0.62 * Math.cos(c))},${f(cy + r * 0.62 * Math.sin(c))} ${f(cx + r * Math.cos(a))},${f(cy + r * Math.sin(a))} `;
	}
	return d;
}

/** Points régulièrement espacés le long d'une polyligne (pour la haie) */
function lelong(points: Pt[], pas: number): Pt[] {
	const resultat: Pt[] = [];
	for (let i = 0; i < points.length - 1; i++) {
		const [[x1, y1], [x2, y2]] = [points[i], points[i + 1]];
		const n = Math.round(Math.hypot(x2 - x1, y2 - y1) / pas);
		for (let j = 0; j < n; j++) resultat.push([x1 + ((x2 - x1) * j) / n, y1 + ((y2 - y1) * j) / n]);
	}
	return resultat;
}

const parcelle = 'M70,70 L840,58 L858,772 L62,790 Z';
const courbesNiveau = [
	{ d: courbe([[64, 250], [260, 236], [470, 262], [660, 240], [852, 258]]), cote: '856', y: 244 },
	{ d: courbe([[64, 480], [250, 470], [470, 500], [690, 476], [855, 492]]), cote: '854', y: 474 },
	{ d: courbe([[62, 712], [280, 700], [500, 726], [700, 704], [857, 716]]), cote: '852', y: 704 },
];

const allee = courbe([[212, 790], [228, 690], [300, 600], [292, 482], [256, 364]]);
const bassin = formeFermee([[488, 152], [560, 126], [640, 150], [656, 205], [612, 250], [532, 256], [486, 216]]);
const prairie = formeFermee([[346, 472], [480, 444], [628, 458], [776, 520], [790, 636], [684, 696], [520, 690], [384, 650], [336, 566]]);
const massif = formeFermee([[420, 372], [520, 348], [612, 368], [590, 420], [470, 432], [418, 410]]);
const kiosque = Array.from({ length: 8 }, (_, i): Pt => {
	const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
	return [690 + 40 * Math.cos(a), 346 + 40 * Math.sin(a)];
});
const pasJaponais: Pt[] = [[425, 318], [452, 300], [478, 282], [503, 266]];
const carres: Pt[] = [[612, 716], [682, 716], [752, 716]];

const arbres = [
	{ x: 735, y: 205, r: 80, bosses: 14, graine: 0.3 }, // tamarin des Hauts
	{ x: 168, y: 505, r: 56, bosses: 11, graine: 1.1 }, // letchi
	{ x: 146, y: 668, r: 42, bosses: 9, graine: 2.0 }, // bibassier
	{ x: 405, y: 735, r: 32, bosses: 8, graine: 0.7 }, // combava
];
const palmistes: Pt[] = [[322, 420], [806, 610]];
const fanjans: Pt[] = [[470, 138], [668, 270], [508, 268]];
const haie = lelong([[440, 76], [700, 68]], 24).concat(lelong([[848, 300], [856, 560]], 24));

const reperes = [
	{ n: 1, x: 255, y: 246 },
	{ n: 2, x: 262, y: 560 },
	{ n: 3, x: 572, y: 196 },
	{ n: 4, x: 560, y: 580 },
	{ n: 5, x: 515, y: 392 },
	{ n: 6, x: 690, y: 346 },
	{ n: 7, x: 760, y: 140 },
	{ n: 8, x: 168, y: 505 },
	{ n: 9, x: 570, y: 72 },
	{ n: 10, x: 712, y: 760 },
	{ n: 11, x: 806, y: 610 },
];

const legende = [
	'Case et varangue',
	'Allée en gravier de basalte',
	'Bassin et fanjans',
	'Prairie fleurie',
	"Massif d'hortensias",
	'Kiosque à l’ombre du tamarin',
	'Tamarin des Hauts',
	'Verger créole : letchi, bibassier, combava',
	"Haie d'essences indigènes",
	'Potager en carrés',
	'Palmistes',
];
---

<figure class="esquisse">
<svg class="plan" viewBox="0 0 920 900" role="img" aria-labelledby="plan-titre plan-desc">
	<title id="plan-titre">Esquisse du jardin Tamarin, au Tampon</title>
	<desc id="plan-desc">
		Plan masse dessiné d'un jardin de 650 m² en pente : une case créole et sa varangue, une allée de gravier
		depuis le portail, un bassin entouré de fougères arborescentes, une prairie fleurie, un kiosque sous un
		grand tamarin des Hauts, un verger, un potager et une haie d'essences indigènes.
	</desc>

	<defs>
		<!-- Trait légèrement tremblé, comme au feutre -->
		<filter id="plan-crayon" x="-2%" y="-2%" width="104%" height="104%">
			<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="bruit"></feTurbulence>
			<feDisplacementMap in="SourceGraphic" in2="bruit" scale="2.6" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
		</filter>
		<!-- Lavis d'aquarelle qui déborde un peu du trait -->
		<filter id="plan-aquarelle" x="-5%" y="-5%" width="110%" height="110%">
			<feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="3" seed="9" result="bruit"></feTurbulence>
			<feDisplacementMap in="SourceGraphic" in2="bruit" scale="9" xChannelSelector="R" yChannelSelector="G" result="deforme"></feDisplacementMap>
			<feGaussianBlur in="deforme" stdDeviation="0.6"></feGaussianBlur>
		</filter>
		<pattern id="plan-hachures" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
			<line x1="0" y1="0" x2="0" y2="7" class="plan__hachure"></line>
		</pattern>
		<pattern id="plan-lames" width="10" height="9" patternUnits="userSpaceOnUse">
			<line x1="0" y1="0.5" x2="10" y2="0.5" class="plan__lame"></line>
		</pattern>
		<pattern id="plan-pointille" width="16" height="16" patternUnits="userSpaceOnUse">
			<circle cx="3" cy="4" r="0.9" class="plan__point"></circle>
			<circle cx="11" cy="9" r="0.9" class="plan__point"></circle>
			<circle cx="6" cy="13" r="0.7" class="plan__point"></circle>
		</pattern>
		<pattern id="plan-gravier" width="9" height="9" patternUnits="userSpaceOnUse">
			<circle cx="2" cy="2" r="0.8" class="plan__point"></circle>
			<circle cx="6.5" cy="5" r="0.6" class="plan__point"></circle>
			<circle cx="3" cy="7.5" r="0.5" class="plan__point"></circle>
		</pattern>
	</defs>

	<rect class="plan__papier" width="920" height="900"></rect>

	<!-- Courbes de niveau : le terrain descend vers la rue -->
	<g class="plan__niveaux">
		{courbesNiveau.map((c) => <path d={c.d} />)}
	</g>
	{courbesNiveau.map((c) => <text class="plan__cote" x="22" y={c.y + 4}>{c.cote}</text>)}

	<!-- Lavis -->
	<g filter="url(#plan-aquarelle)">
		<path d={prairie} class="plan__lavis--herbe"></path>
		<path d={massif} class="plan__lavis--fleurs"></path>
		<path d={bassin} class="plan__lavis--eau"></path>
		<path d={allee} class="plan__lavis--gravier-allee"></path>
		<polygon points={kiosque.map((p) => p.join(',')).join(' ')} class="plan__lavis--gravier"></polygon>
		<rect x="110" y="290" width="290" height="72" class="plan__lavis--bois"></rect>
		{carres.map(([x, y]) => <rect x={x} y={y} width="58" height="42" class="plan__lavis--terre" />)}
		{arbres.map((a) => <path d={houppier(a.x, a.y, a.r, a.bosses, a.graine)} class="plan__lavis--arbre" />)}
		{haie.map(([x, y], i) => <path d={houppier(x, y, 16, 6, i)} class="plan__lavis--haie" />)}
	</g>

	<!-- Trait -->
	<g filter="url(#plan-crayon)" class="plan__trait">
		<path d={parcelle} class="plan__limite"></path>

		<!-- Case et varangue -->
		<rect x="110" y="100" width="290" height="190" class="plan__case"></rect>
		<rect x="110" y="290" width="290" height="72" fill="url(#plan-lames)"></rect>
		<rect x="110" y="290" width="290" height="72"></rect>
		<path d="M232,362 v10 h56 v-10 M232,368 h56"></path>

		<!-- Allée : deux traits de bordure -->
		<path d={allee} class="plan__allee-bord"></path>
		<path d={allee} class="plan__allee-interieur"></path>
		<path d={allee} class="plan__allee-gravier"></path>

		<!-- Bassin -->
		<path d={bassin}></path>
		<path d="M520,190 q18,-8 36,0 M560,214 q16,-7 32,0 M536,234 q12,-5 24,0" class="plan__fin"></path>

		<!-- Pas japonais -->
		{pasJaponais.map(([x, y], i) => <ellipse cx={x} cy={y} rx="11" ry="7" transform={`rotate(${-30 + i * 4} ${x} ${y})`} class="plan__pierre" />)}

		<!-- Prairie, massif, kiosque, potager -->
		<path d={prairie} fill="url(#plan-pointille)"></path>
		<path d={massif} class="plan__fin"></path>
		{[[440, 395], [470, 380], [505, 368], [540, 380], [575, 375], [495, 410], [455, 412], [550, 404]].map(([x, y], i) => (
			<path d={houppier(x, y, 9, 5, i)} class="plan__fin" />
		))}
		<polygon points={kiosque.map((p) => p.join(',')).join(' ')}></polygon>
		<path d={kiosque.map(([x, y]) => `M690,346 L${f(x)},${f(y)}`).join(' ')} class="plan__fin"></path>
		{carres.map(([x, y]) => (
			<>
				<rect x={x} y={y} width="58" height="42" />
				<path d={`M${x + 6},${y + 14} h46 M${x + 6},${y + 28} h46`} class="plan__fin" />
			</>
		))}

		<!-- Végétaux -->
		{arbres.map((a) => (
			<>
				<path d={houppier(a.x, a.y, a.r, a.bosses, a.graine)} />
				<circle cx={a.x} cy={a.y} r="3" class="plan__stipe" />
			</>
		))}
		{haie.map(([x, y], i) => <path d={houppier(x, y, 16, 6, i)} class="plan__fin" />)}
		{palmistes.map(([x, y], i) => (
			<>
				<path d={palmes(x, y, 36, 9, i)} />
				<circle cx={x} cy={y} r="3" class="plan__stipe" />
			</>
		))}
		{fanjans.map(([x, y], i) => (
			<>
				<path d={palmes(x, y, 20, 12, i * 0.5)} class="plan__fin" />
				<circle cx={x} cy={y} r="2.5" class="plan__stipe" />
			</>
		))}

		<!-- Rue -->
		<path d="M20,814 L900,800" class="plan__fin"></path>
	</g>

	<!-- Textes -->
	<rect x="214" y="180" width="82" height="30" class="plan__etiquette-fond"></rect>
	<text x="255" y="201" class="plan__etiquette">CASE</text>
	<text x="255" y="333" class="plan__italique">varangue</text>
	<text x="212" y="808" class="plan__italique">portail</text>
	<text x="470" y="842" class="plan__rue">CHEMIN DES TAMARINS</text>

	{reperes.map((r) => (
		<g class="plan__repere">
			<circle cx={r.x} cy={r.y} r="13"></circle>
			<text x={r.x} y={r.y + 4.5}>{r.n}</text>
		</g>
	))}

	<!-- Nord -->
	<g class="plan__nord" transform="translate(888 64)">
		<path d="M0,-30 L9,8 L0,2 L-9,8 Z"></path>
		<text y="28">N</text>
	</g>

	<!-- Échelle graphique : 26 unités = 1 m -->
	<g class="plan__echelle" transform="translate(640 872)">
		<rect width="130" height="6" class="plan__echelle--plein"></rect>
		<rect x="130" width="130" height="6"></rect>
		<text x="0" y="22">0</text>
		<text x="130" y="22">5</text>
		<text x="260" y="22">10 m</text>
	</g>
</svg>
	<figcaption class="esquisse__legende">
		<p class="surtitre">Exemple d'esquisse</p>
		<p class="esquisse__titre">Jardin Tamarin</p>
		<p class="esquisse__lieu">Le Tampon · 850 m d'altitude · 650 m²</p>
		<ol>
			{legende.map((element) => <li>{element}</li>)}
		</ol>
	</figcaption>
</figure>

<style>
	.esquisse {
		display: grid;
		gap: var(--e-6);
	}

	.esquisse__titre {
		margin-top: var(--e-3);
		font-family: var(--f-titre);
		font-size: var(--t-3);
		line-height: 1.1;
	}

	.esquisse__lieu {
		margin-top: var(--e-2);
		font-size: var(--t--1);
		color: var(--c-encre-douce);
	}

	.esquisse ol {
		display: grid;
		gap: var(--e-2);
		margin-top: var(--e-5);
		padding: 0;
		list-style: none;
		counter-reset: repere;
	}

	.esquisse li {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		align-items: baseline;
		font-size: var(--t--1);
		counter-increment: repere;
	}

	.esquisse li::before {
		content: counter(repere);
		display: grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border: 1px solid var(--c-encre);
		border-radius: 50%;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1;
	}

	@media (min-width: 64rem) {
		.esquisse {
			grid-template-columns: 2.4fr 1fr;
			align-items: end;
			column-gap: var(--e-7);
		}
	}

	.plan {
		--p-papier: #f2eee3;
		--p-encre: #2a2a26;
		--p-crayon: #6f6b60;
		width: 100%;
		height: auto;
	}

	.plan__papier {
		fill: var(--p-papier);
	}

	.plan__niveaux path {
		fill: none;
		stroke: var(--p-crayon);
		stroke-width: 1;
		stroke-dasharray: 2 6;
		opacity: 0.7;
	}

	.plan__cote {
		font-family: var(--f-texte);
		font-size: 13px;
		font-style: italic;
		fill: var(--p-crayon);
	}

	/* Lavis */
	.plan__lavis--herbe {
		fill: #c8d3a1;
		opacity: 0.85;
	}

	.plan__lavis--fleurs {
		fill: #b7bfdc;
		opacity: 0.9;
	}

	.plan__lavis--eau {
		fill: #a6c4c6;
	}

	.plan__lavis--gravier {
		fill: #e0d5bd;
	}

	.plan__lavis--gravier-allee {
		fill: none;
		stroke: #e0d5bd;
		stroke-width: 34;
		stroke-linecap: round;
	}

	.plan__lavis--bois {
		fill: #d9c194;
		opacity: 0.8;
	}

	.plan__lavis--terre {
		fill: #b9a275;
		opacity: 0.75;
	}

	.plan__lavis--arbre {
		fill: #7f9b68;
		opacity: 0.45;
	}

	.plan__lavis--haie {
		fill: #6e8c5c;
		opacity: 0.5;
	}

	/* Trait */
	.plan__trait {
		fill: none;
		stroke: var(--p-encre);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.plan__trait .plan__fin {
		stroke-width: 0.9;
	}

	.plan__limite {
		stroke-width: 1.4;
		stroke-dasharray: 16 6 3 6;
	}

	.plan__case {
		fill: url(#plan-hachures);
		stroke-width: 3;
	}

	.plan__hachure,
	.plan__lame {
		stroke: var(--p-encre);
		stroke-width: 0.8;
	}

	.plan__lame {
		stroke-width: 0.6;
	}

	.plan__point {
		fill: var(--p-encre);
		opacity: 0.55;
	}

	.plan__allee-bord {
		stroke-width: 32;
	}

	.plan__allee-interieur {
		stroke: var(--p-papier);
		stroke-width: 29;
		opacity: 1;
	}

	.plan__allee-gravier {
		stroke: url(#plan-gravier);
		stroke-width: 29;
	}

	.plan__pierre {
		fill: #e9e1cf;
	}

	.plan__stipe {
		fill: var(--p-encre);
		stroke: none;
	}

	/* Textes */
	.plan__etiquette-fond {
		fill: var(--p-papier);
	}

	.plan__etiquette,
	.plan__rue {
		font-family: var(--f-texte);
		font-size: 15px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-anchor: middle;
		fill: var(--p-encre);
	}

	.plan__rue {
		font-size: 13px;
		letter-spacing: 0.3em;
		fill: var(--p-crayon);
	}

	.plan__italique {
		font-family: var(--f-titre);
		font-size: 16px;
		font-style: italic;
		text-anchor: middle;
		fill: var(--p-encre);
	}

	.plan__repere circle {
		fill: var(--p-papier);
		stroke: var(--p-encre);
		stroke-width: 1.2;
	}

	.plan__repere text {
		font-family: var(--f-texte);
		font-size: 13px;
		font-weight: 500;
		text-anchor: middle;
		fill: var(--p-encre);
	}

	.plan__nord path {
		fill: var(--p-encre);
	}

	.plan__nord text,
	.plan__echelle text {
		font-family: var(--f-texte);
		font-size: 13px;
		text-anchor: middle;
		fill: var(--p-encre);
	}

	.plan__echelle rect {
		fill: var(--p-papier);
		stroke: var(--p-encre);
		stroke-width: 1;
	}

	.plan__echelle .plan__echelle--plein {
		fill: var(--p-encre);
	}
</style>
